{
    "HTML5 İskelet": {
        "prefix": "HT5",
        "body": [
            "<!DOCTYPE html>",
            "<html lang=\"tr\">",
            "<head>",
            "    <meta charset=\"UTF-8\">",
            "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
            "    <link rel=\"stylesheet\" href=\"/CSS/${TM_FILENAME_BASE}.CSS\">",
            "    <link rel=\"icon\" href=\"favicon.ico\" type=\"image/x-icon\">",
            "    <title>$1</title>",
            "</head>",
            "<body>",
            "    $2",
            "    $2",
            "    $2",
            "    <script src=\"/JS/${TM_FILENAME_BASE}.JS\"></script>",
            "</body>",
            "</html>"
        ],
        "description": "Dosya adına göre otomatik CSS/JS bağlantılı HTML5"
    },
    "HTML5 All-in-One (Tek Dosya)": {
        "prefix": "HT",
        "body": [
            "<!DOCTYPE html>",
            "",
            "<!-- --------------- HTML --------------- -->",
            "",
            "<html lang=\"tr\">",
            "<head>",
            "    <meta charset=\"UTF-8\">",
            "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
            "    <link rel=\"icon\" href=\"favicon.ico\" type=\"image/x-icon\">",
            "    <title>$1</title>",
            "</head>",
            "<body>",
            "    $2",
            "    $2",
            "    $2",
            "</body>",
            "</html>",
            "",
            "<!------------------------------------------>",
            "",
            "<!-- --------------- CSS --------------- -->",
            "",
            "<style>",
            "    $3",
            "    $3",
            "    $3",
            "</style>",
            "",
            "<!----------------------------------------->",
            "",
            "<!-- --------------- JS --------------- -->",
            "",
            "<script>",
            "    $4",
            "    $4",
            "    $4",
            "</script>",
            "",
            "<!---------------------------------------->"
        ],
        "description": "HTML + CSS + JS tek dosyada all-in-one iskelet"
    }
}
